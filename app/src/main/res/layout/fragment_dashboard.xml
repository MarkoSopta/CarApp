<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0221">

    <Button
        android:id="@+id/captureButton"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Take Photo"
        android:textSize="20sp"
        android:textColor="#0D0221"
        android:backgroundTint="#01FF70"
        android:drawableTop="@drawable/ic_camera"
        android:drawableTint="#0D0221"
        android:drawablePadding="16dp"
        android:gravity="center"
        android:layout_margin="4dp" />

    <Button
        android:id="@+id/uploadImageButton"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Choose from Gallery"
        android:textSize="20sp"
        android:textColor="#01FF70"
        android:backgroundTint="#6B2E98"
        android:drawableTop="@drawable/ic_gallery"
        android:drawableTint="#01FF70"
        android:drawablePadding="16dp"
        android:gravity="center"
        android:layout_margin="4dp" />

</LinearLayout>
